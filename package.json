{
  "name": "omp-usage-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node-only omp usage collector and native macOS usage panel",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test packages/usage-core/*.test.mjs apps/macos/*.test.mjs",
    "verify": "npm run check && npm test",
    "macos:build": "node apps/macos/build.mjs",
    "macos:install": "node apps/macos/install.mjs",
    "macos:uninstall": "node apps/macos/uninstall.mjs",
    "release:setup": "node apps/macos/release.mjs setup",
    "release:package": "node apps/macos/release.mjs package",
    "release:publish": "node apps/macos/release.mjs publish",
    "release:prune": "node apps/macos/release.mjs prune",
    "release:ci-build": "node apps/macos/ci-release.mjs build",
    "release:verify-ci": "node apps/macos/ci-release.mjs verify",
    "release:audit": "node apps/macos/release-audit.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
